<!-- Floating live transcript (spec 01 "Floating live transcript window"): 420 x 320, min 260 x 120, resizable,
     movable by its background, always on top, does not take focus (WS_EX_NOACTIVATE), opaque background.
     Top bar: record / stop + time, pause / resume, level dots, "⋯" menu, close. Then the Assist banner
     (while Assist runs, spec 03 §6.8) and the paragraphs. -->
<Window x:Class="MeetingAssistant.App.Shell.FloatingTranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
        Style="{StaticResource Aya.Window}"
        Title="Live Transcript" Icon="/Assets/AppIcon.ico"
        Width="420" Height="320" MinWidth="260" MinHeight="120"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource PageBrush}" MouseLeftButtonDown="Background_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Controls -->
        <DockPanel Margin="6,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding Shell.ToggleRecordingCommand}" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Aya.Button.Ghost}">
                        <Setter Property="ui:Ui.Size" Value="Small" />
                        <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Record}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecordingBrush}" />
                        <Setter Property="ToolTip" Value="Start recording" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Shell.IsRecording}" Value="True">
                                <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Stop}" />
                                <Setter Property="Content" Value="{Binding Shell.RecordingClock}" />
                                <Setter Property="ToolTip" Value="Stop recording" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding TogglePauseCommand}" VerticalAlignment="Center"
                    IsEnabled="{Binding Shell.IsRecording, Converter={StaticResource Not}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Aya.Button.Ghost}">
                        <Setter Property="ui:Ui.Size" Value="Small" />
                        <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Pause}" />
                        <Setter Property="ToolTip" Value="Pause listening" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Play}" />
                                <Setter Property="ToolTip" Value="Resume listening" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Level dots: mic, and speaker when the mode records call audio -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Ellipse Width="7" Height="7" ToolTip="Microphone">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MicActive}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Width="7" Height="7" Margin="5,0,0,0" ToolTip="Call audio"
                         Visibility="{Binding ShowSpeakerDot, Converter={StaticResource VisibleWhen}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpeakerActive}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>

            <Button DockPanel.Dock="Right" Style="{StaticResource Aya.IconButton.Borderless}" Width="26" Height="26" FontSize="10"
                    ui:Ui.Icon="{StaticResource Icon.ChromeClose}" Click="Close_Click" ToolTip="Close" VerticalAlignment="Center" />
            <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource Aya.IconButton.Borderless}" Width="26" Height="26"
                    ui:Ui.Icon="{StaticResource Icon.More}" Click="More_Click" ToolTip="More" VerticalAlignment="Center">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Transcript" Command="{Binding CopyCommand}" ui:Ui.Icon="{StaticResource Icon.Copy}" />
                        <MenuItem Header="Clear" Command="{Binding ClearCommand}" ui:Ui.Icon="{StaticResource Icon.Delete}" />
                        <Separator />
                        <MenuItem Header="Larger Text" Command="{Binding LargerCommand}" InputGestureText="Ctrl++" />
                        <MenuItem Header="Smaller Text" Command="{Binding SmallerCommand}" InputGestureText="Ctrl+-" />
                        <Separator />
                        <MenuItem Header="Open MeetingAssistant" Command="{Binding Shell.ShowMainCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DockPanel>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

        <!-- Assist banner (spec 03 §6.8): first question (or status), open points, "updating…", Other / Asked -->
        <ui:Card Grid.Row="1" IsAgent="True" CornerRadius="10" Margin="8" Padding="10" DataContext="{Binding Shell.Assist.Live}"
                 Visibility="{Binding Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Assist}" FontSize="12"
                               Foreground="{DynamicResource AgentTextMidBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock Style="{StaticResource Aya.Text}" FontWeight="Medium" Text="{Binding BannerText}" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel Margin="0,5,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextMutedBrush}">
                    <Button DockPanel.Dock="Right" Content="Asked" Style="{StaticResource Aya.Button.Agent}" ui:Ui.Size="Small" ui:Ui.Pill="True"
                            Command="{Binding AskedCommand}" Margin="6,0,0,0" Visibility="{Binding HasQuestion, Converter={StaticResource VisibleWhen}}" />
                    <Button DockPanel.Dock="Right" Content="Other" Style="{StaticResource Aya.Button.Ghost}" ui:Ui.Size="Small" ui:Ui.Pill="True"
                            Command="{Binding OtherCommand}" Visibility="{Binding HasQuestion, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerOpenText}" Margin="0,0,8,0" Visibility="{Binding BannerOpenText, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="updating…" Foreground="{DynamicResource AgentTextMidBrush}" Visibility="{Binding IsThinking, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ui:Card>

        <!-- Error (orange) -->
        <TextBlock Grid.Row="2" Margin="12,8,12,0" Style="{StaticResource Aya.Text}" Foreground="{DynamicResource WarningBrush}"
                   Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />

        <!-- Paragraphs -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="Scroller" Padding="12,8" ScrollChanged="Scroller_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Paragraphs}" TextElement.FontSize="{Binding FontSize}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{Binding SpeakerBrush, FallbackValue={StaticResource AgentTextMidBrush}, TargetNullValue={StaticResource AgentTextMidBrush}}" x:Name="Who" />
                                    <TextBlock Text="{Binding Time}" Margin="6,0,0,0" Foreground="{DynamicResource TextSubtleBrush}" />
                                    <Ellipse Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource RecordingBrush}" ToolTip="Recorded"
                                             Visibility="{Binding Recorded, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding Final, Mode=OneWay}" />
                                    <Run Text="{Binding Pending, Mode=OneWay}" Foreground="{DynamicResource TextSubtleBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                    <Setter TargetName="Who" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Style="{StaticResource Aya.Text.Muted}" Margin="12" Text="{Binding EmptyText}" IsHitTestVisible="False"
                       FontSize="{Binding FontSize}" VerticalAlignment="Top" x:Name="Empty" />
            <Button Style="{StaticResource Aya.IconButton}" ui:Ui.Icon="{StaticResource Icon.Down}" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" ToolTip="Jump to latest"
                    Command="{Binding JumpToLatestCommand}" Click="Jump_Click"
                    Visibility="{Binding Following, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
        </Grid>
    </Grid>
</Window>
