<!-- Dictation HUD (spec 04 §1.7): borderless capsule (radius 18, translucent background, 15 % white border),
     text max 520 wide, panel 620 x 200, content at the bottom. Never takes focus, ignores the mouse
     (WS_EX_NOACTIVATE | WS_EX_TRANSPARENT | WS_EX_TOOLWINDOW), topmost. -->
<Window x:Class="MeetingAssistant.App.Shell.DictationHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
        Title="Dictation" Width="620" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False" IsHitTestVisible="False"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Fill" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Window.Resources>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="18" Padding="16,10" Margin="0,0,0,2"
            Background="{DynamicResource PopoverBrush}" BorderBrush="#26FFFFFF" BorderThickness="1">
        <StackPanel MaxWidth="520">
            <StackPanel Orientation="Horizontal" TextElement.FontSize="14" TextElement.FontWeight="Medium"
                        TextElement.Foreground="{DynamicResource TextBrush}">
                <!-- Listening -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsListening, Converter={StaticResource VisibleWhen}}">
                    <TextBlock FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{StaticResource Icon.Mic}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecordingBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlus}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource Icon.Assist}" />
                                        <Setter Property="Foreground" Value="#AF52DE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ListeningText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- 5 level bars, heights 6, 9, 12, 15, 18, red when lit -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Rectangle" BasedOn="{StaticResource Bar}" />
                        </StackPanel.Resources>
                        <Rectangle Height="6" x:Name="B0" />
                        <Rectangle Height="9" x:Name="B1" />
                        <Rectangle Height="12" x:Name="B2" />
                        <Rectangle Height="15" x:Name="B3" />
                        <Rectangle Height="18" x:Name="B4" />
                    </StackPanel>
                </StackPanel>
                <!-- Transcribing -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTranscribing, Converter={StaticResource VisibleWhen}}">
                    <ui:Spinner Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="480" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Message -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock FontFamily="{StaticResource Font.Icon}" Text="{StaticResource Icon.Info}" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="480" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <!-- Preview / final text, max 3 lines, secondary while listening -->
            <TextBlock Text="{Binding PreviewTail}" FontSize="14" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                       Visibility="{Binding ShowPreview, Converter={StaticResource VisibleWhen}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PreviewIsSecondary}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
