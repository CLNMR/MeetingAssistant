<!-- Settings › Voices (spec 04 §6.4): voice sample (voiceprint) and remembered voices. -->
<UserControl x:Class="MeetingAssistant.App.Views.VoicesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             xmlns:vm="clr-namespace:MeetingAssistant.App.ViewModels">
    <UserControl.DataContext>
        <vm:VoicesSettingsViewModel />
    </UserControl.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource Aya.Text}" FontWeight="SemiBold" Text="Your voice" Margin="0,0,0,8" />
        <ui:Card Padding="16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Text="{Binding Explanation}" />
                <DockPanel Margin="0,12,0,0" Visibility="{Binding HasVoiceprint, Converter={StaticResource VisibleWhen}}">
                    <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteVoiceprintCommand}" />
                    <TextBlock Style="{StaticResource Aya.Text}" VerticalAlignment="Center">
                        <Run Text="Voice sample  " Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding VoiceprintText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhen}}">
                    <Border Padding="8" CornerRadius="6" Background="{DynamicResource MutedBrush}">
                        <TextBlock Style="{StaticResource Aya.Text}" TextWrapping="Wrap" Text="{Binding ReadingText}" />
                    </Border>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Width="18" Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Mic}"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Width="60" Margin="8,0,0,0" Style="{StaticResource Aya.Text.Muted}" Text="{Binding SecondsText}" />
                        <ProgressBar Height="8" Maximum="1" Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Aya.Button.Primary}"
                            Content="{Binding FinishTitle}" Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}" />
                </StackPanel>
                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="{Binding RecordTitle}" Command="{Binding RecordCommand}"
                        IsEnabled="{Binding CanRecord}" Visibility="{Binding NotRecording, Converter={StaticResource VisibleWhen}}" />
                <ui:Spinner Margin="0,10,0,0" Width="16" Height="16" HorizontalAlignment="Left"
                            Visibility="{Binding Busy, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Text="{Binding Message}"
                           Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </ui:Card>

        <TextBlock Style="{StaticResource Aya.Text}" FontWeight="SemiBold" Text="Remembered voices" Margin="0,18,0,8" />
        <ui:Card Padding="16,8">
            <StackPanel>
                <TextBlock Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Margin="0,4"
                           Text="When you rename a speaker in a transcript, MeetingAssistant remembers the voice and names that person automatically next time."
                           Visibility="{Binding LibraryEmpty, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding Library}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VoiceEntry}">
                            <DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Forget" ui:Ui.Size="Small"
                                        Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Style="{StaticResource Aya.Text}" VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
