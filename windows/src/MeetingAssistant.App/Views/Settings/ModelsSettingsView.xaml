<!-- Settings › Models (spec 04 §6.5; Windows: sherpa-onnx models, sizes, download and delete). -->
<UserControl x:Class="MeetingAssistant.App.Views.ModelsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             xmlns:vm="clr-namespace:MeetingAssistant.App.ViewModels">
    <UserControl.DataContext>
        <vm:ModelsSettingsViewModel />
    </UserControl.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource Aya.Text}" FontWeight="SemiBold" Text="Models (all run locally)" Margin="0,0,0,8" />
        <ui:Card Padding="16,8">
            <ItemsControl ItemsSource="{Binding Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModelRow}">
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Aya.Text.Muted}" Text="{Binding Size}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Aya.Text}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Aya.Text.CaptionMuted}" Text="{Binding Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:Card>
        <TextBlock Style="{StaticResource Aya.Text.CaptionMuted}" Margin="0,6,0,0" Text="{Binding TotalSize}" TextWrapping="Wrap"
                   Visibility="{Binding TotalSize, Converter={StaticResource VisibleWhen}}" />

        <ui:Card Padding="16,12" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Aya.Text}" Text="{Binding Message}" />
                    <ProgressBar Margin="0,6,0,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                    <Button Style="{StaticResource Aya.Button.Primary}" Content="{Binding DownloadTitle}" Command="{Binding DownloadCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Aya.Button.Ghost}" Content="Delete Models…" Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanDelete}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Aya.Text.CaptionMuted}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Models are downloaded once from the sherpa-onnx releases on GitHub and kept on this PC. Audio and transcripts never leave this PC." />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
