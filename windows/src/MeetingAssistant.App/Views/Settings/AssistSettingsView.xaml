<!-- Settings › Assist (spec 03 §11, 04 §6.6): Aya connection, lists, links, template tables field, Claude Code, model and
     update frequency. Everything saves on change. DataContext: AssistSettingsViewModel (set in code-behind). -->
<UserControl x:Class="MeetingAssistant.App.Views.AssistSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             xmlns:v="clr-namespace:MeetingAssistant.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MeetingAssistant;component/Views/Assist/AssistResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Group" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20">
        <!-- Aya -->
        <Border Style="{StaticResource Group}" DataContext="{Binding Form}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:LogoTile Width="36" Height="36" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Aya" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Organization id" Style="{StaticResource RowLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding OrgId, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="app.hey-aya.ai/org/&lt;id&gt;/…"
                         AutomationProperties.Name="Organization id" />
                <TextBlock Text="API key" Style="{StaticResource RowLabel}" Margin="0,8,0,4" />
                <v:ApiKeyBox />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{Binding ConnectTitle}" Style="{StaticResource Aya.Button.Primary}" Command="{Binding ConnectCommand}" />
                    <Button Content="Remove Key" Margin="8,0,0,0" Command="{Binding RemoveKeyCommand}"
                            Visibility="{Binding Aya.HasApiKey, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <ui:StepLine Margin="0,8,0,0" Kind="{Binding Aya.ConnectState, Converter={StaticResource StepKind}}" Message="{Binding Aya.ConnectState.Text}" />
            </StackPanel>
        </Border>

        <!-- Lists and links -->
        <StackPanel Visibility="{Binding ShowLists, Converter={StaticResource VisibleWhen}}">
            <ui:Eyebrow Text="Lists" Margin="4,0,0,6" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Grid DockPanel.Dock="Right" Width="300">
                                        <v:AyaSelect ItemsSource="{Binding Choices}" SelectedValue="{Binding Selected}"
                                                     Visibility="{Binding HasCatalog, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Text="{Binding CurrentText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCatalog, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                                    </Grid>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Assist.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Fields" Command="{Binding RefreshFieldsCommand}" />
                        <Button Content="Show All Lists" Margin="8,0,0,0" Command="{Binding ShowAllListsCommand}"
                                Visibility="{Binding ShowAllListsVisible, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Assist.Caption}" Margin="0,8,0,0"
                               Text="A list is used in the workspace where it is defined. Field details come from the workspace's API documentation." />
                </StackPanel>
            </Border>

            <ui:Eyebrow Text="Links" Margin="4,0,0,6" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                        <v:AyaSelect DockPanel.Dock="Right" Width="240" ItemsSource="{Binding Choices}" SelectedValue="{Binding Selected}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowLabel}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding NoneHint}" Style="{StaticResource Assist.Caption}" Margin="0,2,0,0"
                                               Visibility="{Binding ShowHint, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <v:AyaSelect DockPanel.Dock="Right" Width="240" ItemsSource="{Binding TablesChoices}" SelectedValue="{Binding TablesField}" />
                        <TextBlock Text="Template tables → field" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Assist.Caption}" Margin="0,4,0,0"
                               Text="Filled tables from a template are saved under a heading with the template's name. Automatic uses a field named like Protokoll, Leitfaden or Notes, else the summary." />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Claude -->
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AgentBrush}">
                        <TextBlock Text="{StaticResource Icon.Assist}" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                   Foreground="{DynamicResource AgentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Claude" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Runs through Claude Code with your subscription" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClaudeBinaryText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        <ui:StepLine HorizontalAlignment="Right" Kind="{Binding Aya.ClaudeState, Converter={StaticResource StepKind}}" Message="{Binding Aya.ClaudeState.Text}" />
                    </StackPanel>
                    <TextBlock Text="Claude Code" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                </DockPanel>
                <TextBlock Text="Path (optional)" Style="{StaticResource RowLabel}" Margin="0,10,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0" Command="{Binding CheckCommand}" />
                    <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged, Delay=500}" ui:Ui.Placeholder="found automatically"
                             AutomationProperties.Name="Claude Code path" />
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <v:AyaSelect DockPanel.Dock="Right" Width="240" ItemsSource="{Binding Models}" SelectedValue="{Binding Model}" />
                    <TextBlock Text="Model" Style="{StaticResource RowLabel}" />
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <v:AyaSelect DockPanel.Dock="Right" Width="240" ItemsSource="{Binding Frequencies}" SelectedValue="{Binding Frequency}" />
                    <TextBlock Text="Update frequency" Style="{StaticResource RowLabel}" />
                </DockPanel>
                <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource Assist.Caption}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Assist.Caption}" Margin="0,6,0,0"
                           Text="In Assist mode the transcript text and the client context from Aya are sent to Claude (Anthropic). Audio never leaves this PC. Scribe mode stays fully local." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
