<!-- Live screen (spec 03 §6): status bar, "What did I miss?" card, next question, Summary | Open points | Checklist with
     resize handles, template tables, attendees and the live transcript (height adjustable). DataContext: AssistLiveViewModel. -->
<UserControl x:Class="MeetingAssistant.App.Views.AssistLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MeetingAssistant;component/Views/Assist/AssistResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Resize handles: 8 px hit area with a capsule (3 x 36, or 36 x 3) that turns primary 60 % on hover. -->
            <ControlTemplate x:Key="HandleH" TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="Cap" CornerRadius="1.5" Background="{DynamicResource BorderBrush}" Width="3"
                            Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Cap" Property="Background" Value="{DynamicResource PrimaryBorder60Brush}" />
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Cap" Property="Background" Value="{DynamicResource PrimaryBorder60Brush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <ControlTemplate x:Key="HandleV" TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="Cap" CornerRadius="1.5" Background="{DynamicResource BorderBrush}" Width="36"
                            Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Cap" Property="Background" Value="{DynamicResource PrimaryBorder60Brush}" />
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Cap" Property="Background" Value="{DynamicResource PrimaryBorder60Brush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TranscriptRow" Height="240" />
        </Grid.RowDefinitions>

        <!-- 6.1 Status bar -->
        <ui:Card IsAgent="True" IsLit="{Binding Paused, Converter={StaticResource Not}}" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AgentBrush}" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#35D2C1" BlurRadius="14" ShadowDepth="0" Opacity="0.65" />
                    </Border.Effect>
                    <TextBlock x:Name="DotIcon" Text="{StaticResource Icon.Mic}" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                               Foreground="{DynamicResource AgentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:Eyebrow Text="{Binding ListeningText}" Foreground="{DynamicResource AgentTextMidBrush}" />
                    <TextBlock Text="{Binding ElapsedText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding WaveBars}" ItemsPanel="{StaticResource Assist.Row}" Height="24" Margin="12,0,0,0"
                              VerticalAlignment="Center" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="3" Height="{Binding}" CornerRadius="1.5" Margin="0,0,2,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AgentWaveBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="16,0,16,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TemplateTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding TemplateTitle, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Stop" Style="{StaticResource Aya.Button.Destructive}" ui:Ui.Pill="True"
                        ui:Ui.Icon="{StaticResource Icon.Stop}" Command="{Binding StopCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{Binding PauseTitle}" ui:Ui.Pill="True" Command="{Binding TogglePauseCommand}" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip="Pause the assistant; recording and transcript continue.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Aya.Button.Secondary}">
                            <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Pause}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paused}" Value="True">
                                    <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Play}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MissButton" DockPanel.Dock="Right" Content="What did I miss?" Style="{StaticResource Aya.Button.Ghost}"
                        ui:Ui.Icon="{StaticResource Icon.History}" Margin="8,0,0,0" VerticalAlignment="Center" Click="Miss_Click"
                        IsEnabled="{Binding CatchUpBusy, Converter={StaticResource Not}}"
                        ToolTip="A short summary of the last minutes, for when you were distracted" />
                <ui:AyaTag DockPanel.Dock="Right" Text="{Binding UpdatesText}" Tint="{DynamicResource AgentTextMidBrush}" Margin="8,0,0,0"
                           VerticalAlignment="Center" ToolTip="{Binding CostTooltip}" />
                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="260">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsThinking, Converter={StaticResource VisibleWhen}}">
                        <ui:Spinner Width="10" Height="10" Foreground="{DynamicResource AgentTextMidBrush}" Margin="0,0,5,0" />
                        <TextBlock Text="Thinking" FontSize="11" Foreground="{DynamicResource AgentTextMidBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsThinking, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </ui:Card>

        <!-- 6.2 Catch-up card -->
        <ui:Card Grid.Row="1" Padding="14" Margin="0,8,0,0" Visibility="{Binding ShowCatchUp, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Aya.Button.Ghost}" ui:Ui.Size="Small" ui:Ui.Icon="{StaticResource Icon.Close}"
                            ToolTip="Close" AutomationProperties.Name="Close" Command="{Binding CloseCatchUpCommand}" />
                    <ui:Eyebrow Text="{Binding CatchUpTitle}" Icon="{StaticResource Icon.Clock}" Foreground="{DynamicResource AgentTextMidBrush}"
                                VerticalAlignment="Center" />
                </DockPanel>
                <ui:StepLine Margin="0,6,0,0" Kind="{Binding Session.CatchUpState, Converter={StaticResource StepKind}}" Message="{Binding Session.CatchUpState.Text}" />
                <TextBox Style="{StaticResource Aya.SelectableText}" Text="{Binding CatchUpText, Mode=OneWay}" FontSize="14" Margin="0,6,0,0"
                         Visibility="{Binding CatchUpText, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </ui:Card>

        <!-- Upper area: question, panels, tables; scrolls only when the window is too small. -->
        <ScrollViewer x:Name="Upper" Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 6.3 Next question -->
                <ui:Card x:Name="QuestionCard" IsAgent="True" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Suggest now" Style="{StaticResource Aya.Button.Ghost}" ui:Ui.Size="Small"
                                    ui:Ui.Icon="{StaticResource Icon.Refresh}" Command="{Binding SuggestNowCommand}"
                                    ToolTip="Ask for a fresh suggestion now (Ctrl+Shift+Space)" />
                            <ui:Eyebrow Text="Next question" Icon="{StaticResource Icon.Assist}" Foreground="{DynamicResource AgentTextMidBrush}"
                                        VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding QuestionEmptyText}" FontSize="17" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasQuestion, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <StackPanel Visibility="{Binding HasQuestion, Converter={StaticResource VisibleWhen}}">
                            <Grid>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Assist.Highlight}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirstChanged}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" /></Storyboard></BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6" /></Storyboard></BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBox Style="{StaticResource Aya.SelectableText}" Text="{Binding First.Text, Mode=OneWay}" FontSize="21" FontWeight="Medium" />
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Asked" Style="{StaticResource Aya.Button.Agent}" ui:Ui.Pill="True" ui:Ui.Icon="{StaticResource Icon.Check}"
                                        Command="{Binding AskedCommand}" Margin="8,0,0,0" ToolTip="I asked this; it won't be suggested again" />
                                <Button DockPanel.Dock="Right" Content="Other" ui:Ui.Pill="True" ui:Ui.Icon="{StaticResource AIcon.Forward}" Command="{Binding OtherCommand}"
                                        Margin="8,0,0,0" ToolTip="Not this one; suggest something else" />
                                <ui:AyaTag Text="{Binding FirstChecklistItem}" Icon="{StaticResource Icon.Checklist}" Tint="{DynamicResource AgentTextMidBrush}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding FirstChecklistItem, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding FirstWhy}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="34"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Alternatives}" ItemsPanel="{StaticResource Assist.Flow}" Margin="0,10,0,0"
                                          Visibility="{Binding Alternatives.Count, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Aya.Chip}" Margin="0,0,6,6" ToolTip="Show this one first"
                                                Command="{Binding DataContext.PromoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource AIcon.Forward}" FontFamily="{StaticResource Font.Icon}" FontSize="11" Margin="0,2,6,0" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="520" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 6.4 Panels row -->
                <Grid x:Name="Panels" Margin="0,8,0,0" Height="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SummaryCol" Width="400" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition x:Name="OpenCol" Width="300" />
                        <ColumnDefinition x:Name="HandleCol2" Width="8" />
                        <ColumnDefinition x:Name="ChecklistCol" Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:PanelBox Header="Summary" Icon="{StaticResource Icon.Summary}" Trailing="{Binding SummaryCount}">
                        <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SummaryList" ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Assist.SummaryParagraph}" />
                        </ScrollViewer>
                    </ui:PanelBox>
                    <Thumb x:Name="Handle1" Grid.Column="1" Template="{StaticResource HandleH}" Cursor="SizeWE" />

                    <ui:PanelBox Grid.Column="2" Header="Open points" Icon="{StaticResource Icon.OpenPoint}" Trailing="{Binding OpenCount}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OpenPoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Border Style="{StaticResource Assist.Highlight}" />
                                            <DockPanel>
                                                <Button Style="{StaticResource Assist.PlainButton}" ToolTip="{Binding Tooltip}" VerticalAlignment="Top" Margin="0,1,8,0"
                                                        Command="{Binding DataContext.ToggleOpenPointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Tooltip}">
                                                    <TextBlock x:Name="Ic" Text="{StaticResource AIcon.Circle}" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                                </Button>
                                                <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                <Setter TargetName="Ic" Property="Text" Value="{StaticResource Icon.CheckCircle}" />
                                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Setter TargetName="Tx" Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsParked}" Value="True">
                                                <Setter TargetName="Ic" Property="Text" Value="{StaticResource AIcon.PauseCircle}" />
                                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </ui:PanelBox>
                    <Thumb x:Name="Handle2" Grid.Column="3" Template="{StaticResource HandleH}" Cursor="SizeWE"
                           Visibility="{Binding HasChecklist, Converter={StaticResource VisibleWhen}}" />

                    <ui:PanelBox Grid.Column="4" Header="Checklist" Icon="{StaticResource Icon.Checklist}" Trailing="{Binding ChecklistCount}"
                                 Visibility="{Binding HasChecklist, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="4" Margin="0,0,0,10" x:Name="ProgressTrack">
                                <Border CornerRadius="2" Background="{DynamicResource MutedBrush}" />
                                <Border CornerRadius="2" Background="{DynamicResource AgentBrush}" HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource FractionOf}">
                                            <Binding Path="ChecklistProgress" />
                                            <Binding Path="ActualWidth" ElementName="ProgressTrack" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Checklist}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SectionHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,4,0,4" TextWrapping="Wrap" Visibility="{Binding SectionHeader, Converter={StaticResource VisibleWhen}}" />
                                                <Grid Margin="0,0,0,6" ToolTip="{Binding Evidence}">
                                                    <Border Style="{StaticResource Assist.Highlight}" />
                                                    <DockPanel>
                                                        <Button Style="{StaticResource Assist.PlainButton}" VerticalAlignment="Top" Margin="0,1,8,0"
                                                                Command="{Binding DataContext.ToggleChecklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text}">
                                                            <TextBlock x:Name="Ic" Text="{StaticResource AIcon.Circle}" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                                       Foreground="{DynamicResource TextSubtleBrush}" />
                                                        </Button>
                                                        <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                    </DockPanel>
                                                </Grid>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCovered}" Value="True">
                                                    <Setter TargetName="Ic" Property="Text" Value="{StaticResource Icon.CheckCircle}" />
                                                    <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                    <Setter TargetName="Ic" Property="Text" Value="{StaticResource AIcon.HalfCircle}" />
                                                    <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </ui:PanelBox>
                </Grid>

                <!-- 6.5 Tables -->
                <ui:Card x:Name="TablesCard" Padding="12" Margin="0,8,0,0" Visibility="{Binding HasTables, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <ui:Eyebrow Text="Tables" Icon="{StaticResource Icon.Table}" Foreground="{DynamicResource AgentTextMidBrush}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Tables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Assist.PlainButton}" Tag="table" Margin="0,0,10,0" VerticalAlignment="Top"
                                            ToolTip="Open the table to see and correct all cells" AutomationProperties.Name="{Binding Name}">
                                        <Border CornerRadius="10" Padding="10" Background="{DynamicResource PageTranslucentBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FilledText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                               Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </DockPanel>
                                                <Grid x:Name="Track" Height="4" Margin="0,5,0,5">
                                                    <Border CornerRadius="2" Background="{DynamicResource MutedBrush}" />
                                                    <Border CornerRadius="2" Background="{DynamicResource AgentBrush}" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource FractionOf}">
                                                                <Binding Path="Fraction" />
                                                                <Binding Path="ActualWidth" ElementName="Track" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Latest}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,2">
                                                                <Border Style="{StaticResource Assist.Highlight}" />
                                                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 6.6 Vertical resize handle in the gap above attendees and transcript -->
        <Thumb x:Name="HeightHandle" Grid.Row="3" Template="{StaticResource HandleV}" Cursor="SizeNS"
               ToolTip="Drag to make the transcript taller or shorter" />

        <!-- Attendees -->
        <ui:Card Grid.Row="4" Padding="14,8">
            <DockPanel>
                <ui:Eyebrow Text="Attendees" Icon="{StaticResource Icon.People}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" x:Name="AttendeeScroll">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Recognised from the conversation and from Aya contacts" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"
                                   VerticalAlignment="Center" Visibility="{Binding NoAttendees, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding PresentAttendees}" ItemsPanel="{StaticResource Assist.Row}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Assist.AttendeeChip}" Margin="0,0,6,0" Focusable="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Mentioned" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSubtleBrush}" Margin="6,0,6,0"
                                   VerticalAlignment="Center" Visibility="{Binding HasMentioned, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding MentionedAttendees}" ItemsPanel="{StaticResource Assist.Row}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Assist.AttendeeChip}" Margin="0,0,6,0" Focusable="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </ui:Card>

        <!-- Transcript -->
        <ui:Card Grid.Row="5" Margin="0,8,0,0" Padding="14,10" HasShadow="False" Background="{DynamicResource CardTranslucentBrush}">
            <DockPanel>
                <ui:Eyebrow DockPanel.Dock="Top" Text="Transcript" Icon="{StaticResource Icon.Quote}" Margin="0,0,0,6" />
                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Grid DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <Button x:Name="Sp" Style="{StaticResource Assist.PlainButton}" Tag="speaker" ToolTip="{Binding SpeakerTooltip}"
                                                Visibility="{Binding HasSpeaker, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock x:Name="Name" Text="{Binding SpeakerName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AgentTextMidBrush}" />
                                        </Button>
                                        <TextBlock Text="…" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtleBrush}"
                                                   ToolTip="Speaker not recognised yet"
                                                   Visibility="{Binding HasSpeaker, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                                    </Grid>
                                    <TextBox x:Name="Tx" Style="{StaticResource Aya.SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="12.5"
                                             Foreground="{DynamicResource TextSubtleBrush}" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMic}" Value="True">
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGeneric}" Value="True">
                                        <Setter TargetName="Name" Property="TextDecorations">
                                            <Setter.Value>
                                                <TextDecorationCollection>
                                                    <TextDecoration Location="Underline">
                                                        <TextDecoration.Pen>
                                                            <Pen Thickness="1" Brush="#99888888">
                                                                <Pen.DashStyle><DashStyle Dashes="1,2" /></Pen.DashStyle>
                                                            </Pen>
                                                        </TextDecoration.Pen>
                                                    </TextDecoration>
                                                </TextDecorationCollection>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFinal}" Value="True">
                                        <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </ui:Card>
    </Grid>
</UserControl>
