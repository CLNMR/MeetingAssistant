<!-- Person popover (spec 03 §6.7): 330 px, 14 px padding. Header (32 px initial circle, name, subtitle), the
     "important" Aya fields, and for speakers the rename box ("Who is this?"). DataContext: PersonCardViewModel. -->
<UserControl x:Class="MeetingAssistant.App.Views.PersonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             Width="330">
    <UserControl.Resources>
        <ResourceDictionary Source="/MeetingAssistant;component/Views/Assist/AssistResources.xaml" />
    </UserControl.Resources>
    <StackPanel Margin="14">
        <DockPanel>
            <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryTint12Brush}">
                <TextBlock x:Name="Ini" Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Details}" Margin="0,12,0,0" Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhen}}"
                      Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        <TextBox Grid.Column="1" Style="{StaticResource Aya.SelectableText}" Text="{Binding Value, Mode=OneWay}" FontSize="12"
                                 TextWrapping="Wrap" MaxHeight="68" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding CanRename, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Who is this?" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
            <TextBox x:Name="NameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Name">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ItemsControl ItemsSource="{Binding Hits}" ItemsPanel="{StaticResource Assist.Flow}" Margin="0,8,0,0"
                          Visibility="{Binding Hits.Count, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Aya.Chip}" Content="{Binding}" Margin="0,0,6,6"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Save" Style="{StaticResource Aya.Button.Primary}" ui:Ui.Size="Small" HorizontalAlignment="Right" Margin="0,8,0,0"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
