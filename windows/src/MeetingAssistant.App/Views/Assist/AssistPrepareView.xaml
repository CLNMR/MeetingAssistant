<!-- Prepare screen (spec 03 §5): header with "Aya lists updated …" and Refresh, the "Planned in Aya" strip, the client
     column, template / project cards, the meeting row (mode, goal), the "What Claude will know" preview and the
     footer with the Claude line and Start Assist. DataContext: AssistPrepareViewModel. -->
<UserControl x:Class="MeetingAssistant.App.Views.AssistPrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             xmlns:v="clr-namespace:MeetingAssistant.App.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/MeetingAssistant;component/Views/Assist/AssistResources.xaml" />
    </UserControl.Resources>
    <Grid>
        <ui:Backdrop />
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <ui:PageHeader Eyebrow="Assist" Title="Prepare meeting"
                           Subtitle="Pick a meeting planned in Aya, or choose a template, client and project. Claude reads them before the meeting starts.">
                <ui:PageHeader.Trailing>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ListsUpdatedText}" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Visibility="{Binding ListsUpdatedText, Converter={StaticResource VisibleWhen}}" />
                        <Button Content="Refresh" ui:Ui.Icon="{StaticResource Icon.Refresh}" Command="{Binding RefreshCommand}"
                                ToolTip="Reload planned meetings, templates, clients and projects from Aya" />
                    </StackPanel>
                </ui:PageHeader.Trailing>
            </ui:PageHeader>

            <!-- Planned in Aya -->
            <ui:Card Grid.Row="1" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="The recap is saved to this meeting afterwards." FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding HasPlannedMeeting, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Eyebrow Text="Planned in Aya" Icon="{StaticResource Icon.Calendar}" VerticalAlignment="Center" />
                            <TextBlock Text="today and the next 14 days" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PlannedCards}" ItemsPanel="{StaticResource Assist.Row}" Margin="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Assist.PlainButton}" Margin="0,0,8,0" ToolTip="{Binding Tooltip}"
                                            Command="{Binding DataContext.PickPlannedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                                        <Border x:Name="Bd" Width="210" Height="84" CornerRadius="10" BorderThickness="1" Padding="10"
                                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <DockPanel x:Name="Top" TextElement.Foreground="{DynamicResource TextMutedBrush}">
                                                    <ui:AyaTag DockPanel.Dock="Right" Text="Notes" Tint="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock x:Name="Glyph" Text="{StaticResource Icon.Calendar}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding TopLine}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Links}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                           Visibility="{Binding Links, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Add}" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBorder60Brush}" />
                                            <Setter TargetName="Top" Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </ui:Card>

            <!-- Client column | template, project, meeting, preview -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="260" MaxWidth="340" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <ui:Card Padding="14" Margin="0,0,8,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ClientCount}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <ui:Eyebrow Text="Client" Icon="{StaticResource Icon.Building}" />
                        </DockPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource Aya.SearchBox}" Margin="0,0,0,10"
                                 Text="{Binding ClientFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search clients" />
                        <ui:StepLine DockPanel.Dock="Bottom" Margin="0,8,0,0" Kind="{Binding Aya.ListState, Converter={StaticResource StepKind}}"
                                     Message="{Binding Aya.ListState.Text}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ClientRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Assist.PlainButton}" Margin="0,0,0,2"
                                                Command="{Binding DataContext.PickClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Background="Transparent">
                                                <DockPanel>
                                                    <Border x:Name="Av" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PrimaryTint10Brush}">
                                                        <TextBlock x:Name="Ini" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="T" Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhen}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                <Setter TargetName="Ini" Property="Text" Value="&#xE738;" />
                                                <Setter TargetName="Ini" Property="FontFamily" Value="{StaticResource Font.Icon}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                                                <Setter TargetName="Av" Property="Background" Value="{DynamicResource BrandBrush}" />
                                                <Setter TargetName="Ini" Property="Foreground" Value="White" />
                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Template -->
                        <ui:Card Padding="14" Margin="0,0,4,0">
                            <StackPanel>
                                <ui:Eyebrow Text="Template" Icon="{StaticResource Icon.Checklist}" Margin="0,0,0,10" />
                                <v:AyaSelect ItemsSource="{Binding TemplateChoices}" SelectedValue="{Binding TemplateID}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <ui:AyaTag Text="{Binding TemplateType}" Margin="0,0,6,0"
                                               Visibility="{Binding TemplateType, Converter={StaticResource VisibleWhen}}" />
                                    <ui:AyaTag Text="{Binding TemplateItemsText}" Icon="{StaticResource Icon.Checklist}" Tint="{DynamicResource AgentTextMidBrush}"
                                               Visibility="{Binding TemplateItemsText, Converter={StaticResource VisibleWhen}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding TemplateGoal}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           MaxHeight="50" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                           Visibility="{Binding TemplateGoal, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </ui:Card>
                        <!-- Project -->
                        <ui:Card Grid.Column="1" Padding="14" Margin="4,0,0,0">
                            <StackPanel>
                                <ui:Eyebrow Text="Project" Icon="{StaticResource Icon.Folder}" Margin="0,0,0,10" />
                                <TextBlock Text="No project list chosen in Settings › Assist." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Visibility="{Binding HasProjectList, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                                <StackPanel Visibility="{Binding HasProjectList, Converter={StaticResource VisibleWhen}}">
                                    <v:AyaSelect ItemsSource="{Binding ProjectChoices}" SelectedValue="{Binding ProjectID}" />
                                    <ui:AyaTag Text="{Binding ProjectStatus}" Tint="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                               Visibility="{Binding ProjectStatus, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <!-- Meeting: mode and goal -->
                    <ui:Card Grid.Row="1" Padding="14" Margin="0,8,0,0">
                        <DockPanel>
                            <ui:Eyebrow Text="Meeting" Icon="{StaticResource Icon.People}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ListBox Style="{StaticResource Aya.Segmented}" ItemsSource="{Binding Modes}" SelectedValuePath="Value"
                                     SelectedValue="{Binding Setup.Mode}" Width="300" Margin="0,0,10,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="Mode" />
                            <TextBox Text="{Binding Setup.Goal, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Goal for this meeting (optional)"
                                     ui:Ui.Icon="{StaticResource Icon.Target}" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="66"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Goal" />
                        </DockPanel>
                    </ui:Card>

                    <!-- What Claude will know -->
                    <ui:Card Grid.Row="2" Padding="14" Margin="0,8,0,0" IsAgent="True" IsLit="{Binding HasPreview}">
                        <DockPanel>
                            <ui:Eyebrow DockPanel.Dock="Top" Text="What Claude will know" Icon="{StaticResource Icon.Assist}"
                                        Foreground="{DynamicResource AgentTextMidBrush}" Margin="0,0,0,10" />
                            <ui:StepLine DockPanel.Dock="Bottom" Margin="0,8,0,0" Kind="{Binding Setup.PreviewState, Converter={StaticResource StepKind}}"
                                         Message="{Binding Setup.PreviewState.Text}" />
                            <Grid>
                                <TextBlock Style="{StaticResource Aya.Text.Muted}" Visibility="{Binding ShowEmptyPreview, Converter={StaticResource VisibleWhen}}"
                                           Text="Nothing chosen yet: Claude then works from the conversation alone. Pick a planned meeting, a template, a client or a project to give it context." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,12" Visibility="{Binding PreviewMeeting, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Meeting" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewMeeting}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12" Visibility="{Binding PreviewClient, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Client" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewClient}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PreviewClientProfile}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                                       MaxHeight="90" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding PreviewClientProfile, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12" Visibility="{Binding PreviewProject, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Project" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewProject}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12" Visibility="{Binding PreviewTemplate, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Template" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewTemplate}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PreviewTemplateItems}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                                       MaxHeight="50" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding PreviewTemplateItems, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12" Visibility="{Binding PreviewContacts.Count, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Contacts" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding PreviewContacts}" ItemsPanel="{StaticResource Assist.Flow}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="999" BorderThickness="1" Padding="10,4" Margin="0,0,6,6"
                                                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Earlier meetings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="None found" FontSize="13" Foreground="{DynamicResource TextSubtleBrush}"
                                                       Visibility="{Binding NoRecaps, Converter={StaticResource VisibleWhen}}" />
                                            <ItemsControl ItemsSource="{Binding PreviewRecaps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding Date}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Start Assist" Style="{StaticResource Aya.Button.Agent}" ui:Ui.Size="Large" ui:Ui.Pill="True"
                        ui:Ui.Icon="{StaticResource Icon.Mic}" Command="{Binding StartCommand}" ToolTip="{Binding StartTooltip}"
                        ToolTipService.ShowOnDisabled="True" />
                <ui:StepLine DockPanel.Dock="Right" Margin="12,0,12,0" VerticalAlignment="Center"
                             Kind="{Binding Assist.StartState, Converter={StaticResource StepKind}}" Message="{Binding Assist.StartState.Text}" />
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ClaudeFailed, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{StaticResource Icon.Warning}" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Aya.ClaudeState.Text}" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="460" />
                        <Button Content="Check Again" ui:Ui.Size="Small" Margin="8,0,0,0" Command="{Binding CheckClaudeCommand}" />
                    </StackPanel>
                    <ui:StepLine Kind="Working" Message="Checking Claude Code…" Visibility="{Binding ClaudeChecking, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClaudeFailed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ClaudeChecking}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{StaticResource Icon.Lock}" FontFamily="{StaticResource Font.Icon}" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ClaudeLine}" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
