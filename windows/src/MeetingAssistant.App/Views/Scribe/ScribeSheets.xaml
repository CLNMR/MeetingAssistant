<!-- Sheets of the Scribe screens (spec 01): Stop Earlier, Trim Recording, Split Recording. Shown by SheetHost. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
                    xmlns:vm="clr-namespace:MeetingAssistant.App.ViewModels"
                    xmlns:v="clr-namespace:MeetingAssistant.App.Views">

    <DataTemplate DataType="{x:Type vm:StopEarlierViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Aya.Text}" FontSize="17" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Message}" />
            <v:TimeChooser Margin="0,16,0,0" DataContext="{Binding Chooser}" />
            <ItemsControl ItemsSource="{Binding Quick}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Command="{Binding Command}" ui:Ui.Size="Small" Margin="0,0,8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Aya.Text.Muted}" Margin="0,12,0,0" Text="{Binding KeepsText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource Aya.Button.Primary}" IsDefault="True" Margin="8,0,0,0"
                        Content="{Binding StopTitle}" Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TrimSheetViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Aya.Text}" FontSize="17" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Message}" />
            <DockPanel Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Left" Width="40" Text="Start" VerticalAlignment="Center" Style="{StaticResource Aya.Text}" />
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" ui:Ui.Size="Small" Content="Playhead"
                        Command="{Binding StartAtPlayheadCommand}" ToolTip="{Binding PlayheadHelp}" />
                <v:TimeChooser DataContext="{Binding Start}" />
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Width="40" Text="End" VerticalAlignment="Center" Style="{StaticResource Aya.Text}" />
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" ui:Ui.Size="Small" Content="Playhead"
                        Command="{Binding EndAtPlayheadCommand}" ToolTip="{Binding PlayheadHelp}" />
                <v:TimeChooser DataContext="{Binding End}" />
            </DockPanel>
            <Button HorizontalAlignment="Left" Margin="0,12,0,0" ui:Ui.Size="Small" Content="{Binding LastSpeechTitle}"
                    Command="{Binding EndAfterLastSpeechCommand}"
                    Visibility="{Binding LastSpeechTitle, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Style="{StaticResource Aya.Text.Muted}" Margin="0,12,0,0" Text="{Binding KeepsText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource Aya.Button.Primary}" IsDefault="True" MinWidth="80" Margin="8,0,0,0"
                        Content="Trim" Command="{Binding TrimCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SplitSheetViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Aya.Text}" FontSize="17" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Aya.Text}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding PauseText}"
                       Visibility="{Binding PauseText, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Style="{StaticResource Aya.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Message}" />
            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" ui:Ui.Size="Small" Content="Playhead"
                        Command="{Binding AtPlayheadCommand}" ToolTip="{Binding PlayheadHelp}" />
                <v:TimeChooser DataContext="{Binding At}" />
            </DockPanel>
            <CheckBox Margin="0,12,0,0" IsChecked="{Binding RemovePause}" Content="{Binding RemovePauseText}"
                      Visibility="{Binding ShowRemovePause, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Style="{StaticResource Aya.Text.Muted}" Margin="0,12,0,0" Text="{Binding PartsText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource Aya.Button.Primary}" IsDefault="True" MinWidth="80" Margin="8,0,0,0"
                        Content="Split" Command="{Binding SplitCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
