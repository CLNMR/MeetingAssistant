<!-- Session detail (spec 01): header with play/pause, editable title, mode, date, speakers, position, Assist Recap;
     search, Export / Transcribe Again / Edit; progress + Cancel while processing; else timeline, split hint,
     speaker bar and the transcript (turns and pause rows); else the empty state with "Transcribe Now". -->
<UserControl x:Class="MeetingAssistant.App.Views.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MeetingAssistant.App.Controls"
             xmlns:vm="clr-namespace:MeetingAssistant.App.ViewModels"
             xmlns:v="clr-namespace:MeetingAssistant.App.Views"
             xmlns:st="clr-namespace:MeetingAssistant.Core.Storage;assembly=MeetingAssistant.Core">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Width="38" Height="38" Command="{Binding TogglePlayCommand}" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="19" Background="{DynamicResource BrandBrush}">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Play}" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Pause}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Play (Space)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="ToolTip" Value="Pause (Space)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Aya.Button.Agent}" ui:Ui.Pill="True" ui:Ui.Icon="{StaticResource Icon.Assist}"
                        Content="Assist Recap" Command="{Binding AssistRecapCommand}" VerticalAlignment="Center"
                        IsEnabled="{Binding AssistRunning, Converter={StaticResource Not}}"
                        ToolTip="Draft the recap and CRM updates for this meeting and upload them to Aya"
                        Visibility="{Binding HasAssist, Converter={StaticResource VisibleWhen}}" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold"
                             BorderThickness="0" Background="Transparent" Padding="0" Height="Auto"
                             GotKeyboardFocus="TitleBox_GotKeyboardFocus" LostKeyboardFocus="TitleBox_LostKeyboardFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CommitTitleCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <WrapPanel Margin="0,3,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock Style="{StaticResource Aya.Icon}" Text="{Binding ModeIcon}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ModeTitle}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SpeakersText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"
                                   Visibility="{Binding SpeakersText, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource Font.Mono}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExportButton" ui:Ui.Icon="{StaticResource Icon.Export}" Content="Export" Click="Menu_Click"
                            IsEnabled="{Binding HasTranscript}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy as Markdown" Command="{Binding CopyMarkdownCommand}" />
                                <MenuItem Header="Copy as Plain Text" Command="{Binding CopyTextCommand}" />
                                <Separator />
                                <MenuItem Header="Save as Markdown…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static st:ExportFormat.Markdown}" />
                                <MenuItem Header="Save as Plain text…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static st:ExportFormat.Text}" />
                                <MenuItem Header="Save as Subtitles (SRT)…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static st:ExportFormat.Srt}" />
                                <MenuItem Header="Save as JSON…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static st:ExportFormat.Json}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="AgainButton" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource Icon.Refresh}" Content="Transcribe Again"
                            Click="Again_Click" IsEnabled="{Binding CanEdit}" />
                    <Button x:Name="EditButton" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource Icon.Edit}" Content="Edit" Click="Menu_Click"
                            IsEnabled="{Binding CanEdit}" ToolTip="Trim the start or end, or split into two recordings">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Trim…" Command="{Binding TrimCommand}" />
                                <MenuItem Header="Split…" Command="{Binding SplitCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBox Style="{StaticResource Aya.SearchBox}" MaxWidth="280" HorizontalAlignment="Left" ui:Ui.Placeholder="Search transcript"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

        <Grid>
            <!-- Processing -->
            <StackPanel Margin="40" VerticalAlignment="Top" Visibility="{Binding IsProcessing, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Aya.Text}" Text="{Binding ProgressMessage}" />
                <ProgressBar Margin="0,8,0,0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                <Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource VisibleWhen}}">
                <TextBlock x:Name="EmptyIcon" HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource TextSubtleBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Aya.Icon}">
                            <Setter Property="Text" Value="{StaticResource Icon.Summary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource Aya.Text.Muted}" FontSize="14" Text="{Binding EmptyText}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource Aya.Button.Primary}" Content="Transcribe Now"
                        Command="{Binding TranscribeNowCommand}" />
            </StackPanel>

            <!-- Transcript -->
            <DockPanel Visibility="{Binding ShowTranscript, Converter={StaticResource VisibleWhen}}">
                <v:RecordingTimeline DockPanel.Dock="Top" Margin="20,10,20,10" />

                <!-- Split hint -->
                <Border DockPanel.Dock="Top" Margin="20,0,20,12" Padding="12" CornerRadius="{StaticResource Radius.Container}"
                        Background="{DynamicResource WarningTint12Brush}" Visibility="{Binding HasSplitHint, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WarningTint12Brush}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Edit}" FontSize="14" Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Aya.Button.Ghost}" ui:Ui.Size="Small" Content="Play" Command="{Binding HintPlayCommand}"
                                    ToolTip="Listen to where speech starts again" />
                            <Button ui:Ui.Size="Small" Margin="6,0,0,0" Content="Dismiss" Command="{Binding HintDismissCommand}" />
                            <Button Style="{StaticResource Aya.Button.Primary}" ui:Ui.Size="Small" Margin="6,0,0,0" Content="Split Here…"
                                    Command="{Binding HintSplitCommand}" IsEnabled="{Binding CanEdit}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Aya.Text}" FontWeight="SemiBold" Text="Two meetings in one recording?" />
                            <TextBlock Style="{StaticResource Aya.Text.Muted}" FontSize="12" TextWrapping="Wrap" Text="{Binding SplitHintText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />
                <!-- Speaker bar -->
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="20,10">
                        <ItemsControl ItemsSource="{Binding Speakers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SpeakerChip}">
                                    <Button Style="{StaticResource Aya.Chip}" Margin="0,0,8,0" Click="Chip_Click" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Medium" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Share}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Aya.Text.CaptionMuted}" VerticalAlignment="Center"
                                   Text="Click a speaker to rename or merge. Right-click a line to change its speaker." />
                    </StackPanel>
                </ScrollViewer>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Turns and pauses -->
                <ListBox x:Name="Lines" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" Padding="12,6"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type vm:TurnRowViewModel}">
                            <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" Padding="8,5" Background="Transparent"
                                    ContextMenuOpening="Turn_ContextMenuOpening">
                                <Border.ContextMenu>
                                    <ContextMenu />
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Aya.LinkButton}" Content="{Binding Time}" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                                            Margin="0,2,12,0" VerticalAlignment="Top" ToolTip="Play from here"
                                            Command="{Binding DataContext.PlayTurnCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding LabelBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Aya.SelectableText}" FontSize="14" Text="{Binding Text, Mode=OneWay}"
                                             Foreground="{DynamicResource TextBrush}" ContextMenu="{x:Null}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PauseRowViewModel}">
                            <Grid Margin="8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Line x:Name="L1" X1="0" X2="2000" Y1="0.5" Y2="0.5" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextMutedBrush}" Opacity="0.5" ClipToBounds="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                    <Button Style="{StaticResource Aya.LinkButton}" Content="{Binding Time}" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                                            VerticalAlignment="Center" ToolTip="Play from here"
                                            Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <TextBlock x:Name="PauseIcon" Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Pause}" FontSize="11" Margin="10,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="PauseText" Text="{Binding Text}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Range}" FontSize="11" FontFamily="{StaticResource Font.Mono}" Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                    <Button ui:Ui.Size="Small" Content="{Binding ActionTitle}"
                                            Command="{Binding DataContext.PauseActionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <Line x:Name="L2" Grid.Column="2" X1="0" X2="2000" Y1="0.5" Y2="0.5" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextMutedBrush}" Opacity="0.5" ClipToBounds="True" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                    <Setter TargetName="L1" Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                    <Setter TargetName="L2" Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                    <Setter TargetName="PauseIcon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Setter TargetName="PauseText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
