<!-- Aya colour tokens, dark appearance (spec 03 §12). Same keys in Colors.Light.xaml and Colors.Dark.xaml;
     ThemeManager swaps the dictionary when Windows switches between light and dark. Control styles
     reference these with DynamicResource so the switch takes effect live. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PageColor">#FF0A0A0A</Color>
    <Color x:Key="CardColor">#FF0E0E0E</Color>
    <Color x:Key="PopoverColor">#FF111111</Color>
    <Color x:Key="RailColor">#FF0F0F0F</Color>
    <Color x:Key="TextColor">#F5FFFFFF</Color>
    <Color x:Key="TextMutedColor">#ADFFFFFF</Color>
    <Color x:Key="TextSubtleColor">#73FFFFFF</Color>
    <Color x:Key="MutedColor">#FF27272A</Color>
    <Color x:Key="HoverColor">#FF27272A</Color>
    <Color x:Key="FieldColor">#0AFFFFFF</Color>
    <Color x:Key="BorderColor">#1AFFFFFF</Color>
    <Color x:Key="InputColor">#24FFFFFF</Color>
    <Color x:Key="PrimaryColor">#FF2563EB</Color>
    <Color x:Key="DestructiveColor">#FFF87171</Color>
    <Color x:Key="DestructiveForegroundColor">#FF0A0A0A</Color>
    <Color x:Key="SuccessColor">#FF4CC97A</Color>
    <Color x:Key="WarningColor">#FFE5B04A</Color>
    <Color x:Key="AgentTextMidColor">#FF8BE2D8</Color>
    <Color x:Key="AgentTextBrightColor">#FFC5ECE8</Color>
    <Color x:Key="RecordingColor">#FFFF453A</Color>
    <Color x:Key="BrandStartColor">#FF0F7DFF</Color>
    <Color x:Key="BrandEndColor">#FF0EAFFF</Color>
    <Color x:Key="AgentColor">#FF35D2C1</Color>
    <Color x:Key="AgentForegroundColor">#C7000000</Color>
    <Color x:Key="AgentGlowColor">#A635D2C1</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>

    <!-- Plain tokens -->
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PopoverBrush" Color="{StaticResource PopoverColor}" />
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="{StaticResource DestructiveForegroundColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="AgentBrush" Color="{StaticResource AgentColor}" />
    <SolidColorBrush x:Key="AgentTextMidBrush" Color="{StaticResource AgentTextMidColor}" />
    <SolidColorBrush x:Key="AgentTextBrightBrush" Color="{StaticResource AgentTextBrightColor}" />
    <SolidColorBrush x:Key="AgentForegroundBrush" Color="{StaticResource AgentForegroundColor}" />
    <SolidColorBrush x:Key="AgentGlowBrush" Color="{StaticResource AgentGlowColor}" />
    <SolidColorBrush x:Key="RecordingBrush" Color="{StaticResource RecordingColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="White" />

    <!-- Derived tints (token at an opacity), as used by the Mac styles -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryColor}" Opacity="0.88" />
    <SolidColorBrush x:Key="PrimaryTint10Brush" Color="{StaticResource PrimaryColor}" Opacity="0.10" />
    <SolidColorBrush x:Key="PrimaryTint12Brush" Color="{StaticResource PrimaryColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="PrimaryBorder60Brush" Color="{StaticResource PrimaryColor}" Opacity="0.60" />
    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="{StaticResource DestructiveColor}" Opacity="0.88" />
    <SolidColorBrush x:Key="AgentHoverBrush" Color="{StaticResource AgentColor}" Opacity="0.85" />
    <SolidColorBrush x:Key="AgentTint14Brush" Color="{StaticResource AgentColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="AgentHighlightBrush" Color="{StaticResource AgentColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="AgentBorder60Brush" Color="{StaticResource AgentColor}" Opacity="0.60" />
    <SolidColorBrush x:Key="SuccessTint12Brush" Color="{StaticResource SuccessColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningTint12Brush" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="CardTranslucentBrush" Color="{StaticResource CardColor}" Opacity="0.70" />
    <SolidColorBrush x:Key="PageTranslucentBrush" Color="{StaticResource PageColor}" Opacity="0.50" />

    <!-- Brand gradient (logo tile, selected client avatar), top-left to bottom-right -->
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource BrandStartColor}" />
        <GradientStop Offset="1" Color="{StaticResource BrandEndColor}" />
    </LinearGradientBrush>
    <!-- Waveform bars: agentTextMid at the top to agent at the bottom -->
    <LinearGradientBrush x:Key="AgentWaveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource AgentTextMidColor}" />
        <GradientStop Offset="1" Color="{StaticResource AgentColor}" />
    </LinearGradientBrush>
    <!-- Backdrop: two soft radial glows (brandEnd 10 % at 35/60 %, agent 9 % at 90/20 %) -->
    <RadialGradientBrush x:Key="BackdropBlueBrush" Center="0.35,0.6" GradientOrigin="0.35,0.6" RadiusX="0.45" RadiusY="0.45" MappingMode="RelativeToBoundingBox">
        <GradientStop Offset="0" Color="#1A0EAFFF" />
        <GradientStop Offset="1" Color="#000EAFFF" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BackdropTealBrush" Center="0.9,0.2" GradientOrigin="0.9,0.2" RadiusX="0.35" RadiusY="0.35" MappingMode="RelativeToBoundingBox">
        <GradientStop Offset="0" Color="#1735D2C1" />
        <GradientStop Offset="1" Color="#0035D2C1" />
    </RadialGradientBrush>
</ResourceDictionary>
