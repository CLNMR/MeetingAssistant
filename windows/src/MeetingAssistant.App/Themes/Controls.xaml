<!-- Aya control styles (spec 03 §3 and §12; Mac AyaTheme.swift). Implicit styles restyle the stock
     WPF controls (Button = secondary, TextBox, PasswordBox, ComboBox, ListBox, CheckBox, ScrollBar,
     ToolTip, ContextMenu, MenuItem, ProgressBar, TabControl); keyed styles give the other kinds:
       Aya.Button.Primary / Secondary / Ghost / Destructive / Agent  (+ ui:Ui.Size, ui:Ui.Pill, ui:Ui.Icon)
       Aya.IconButton / Aya.IconButton.Borderless                   (+ ui:Ui.IsActive, ui:Ui.ShowDot)
       Aya.Chip, Aya.Switch, Aya.Segmented (ListBox), Aya.SettingsTabs (TabControl), Aya.ListItem, Aya.Window
     Colours are DynamicResource (they switch with the Windows appearance); metrics are StaticResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:MeetingAssistant.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Aya.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ui:BrushOpacityConverter x:Key="BrushOpacity" />
    <ui:VisibleWhenConverter x:Key="VisibleWhen" />
    <ui:EqualsConverter x:Key="EqualsTo" />
    <ui:NotConverter x:Key="Not" />

    <!-- ================================================================ Focus -->
    <Style x:Key="Aya.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="10" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource PrimaryBorder60Brush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Window -->
    <Style x:Key="Aya.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource PageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ================================================================ Buttons -->
    <!-- Base = secondary: card fill, border outline, hover fill; 32 px high, radius 8, 13 pt medium. -->
    <Style x:Key="Aya.Button" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="ui:Ui.CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Glow" Visibility="Collapsed" Background="{DynamicResource AgentBrush}"
                                CornerRadius="{Binding (ui:Ui.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#35D2C1" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding (ui:Ui.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBlock x:Name="Icon" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource Font.Icon}" FontSize="12" FontWeight="Normal"
                                           VerticalAlignment="Center" Margin="0,1,6,0" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ui:Ui.Glow" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ui:Ui.Size" Value="Small">
                <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="FontSize" Value="12" />
            </Trigger>
            <Trigger Property="ui:Ui.Size" Value="Large">
                <Setter Property="Height" Value="{StaticResource ControlHeightLarge}" />
                <Setter Property="Padding" Value="18,0" />
            </Trigger>
            <Trigger Property="ui:Ui.Pill" Value="True">
                <Setter Property="ui:Ui.CornerRadius" Value="{StaticResource Radius.Pill}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ui:Ui.Pill" Value="True" />
                    <Condition Property="ui:Ui.Size" Value="Regular" />
                </MultiTrigger.Conditions>
                <Setter Property="Padding" Value="14,0" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Aya.Button.Secondary" TargetType="ButtonBase" BasedOn="{StaticResource Aya.Button}" />
    <Style TargetType="Button" BasedOn="{StaticResource Aya.Button}" />
    <Style TargetType="RepeatButton" BasedOn="{StaticResource Aya.Button}" />
    <!-- Plain toggle buttons: secondary look, checked = primary 10 % fill with primary text -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Aya.Button}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder60Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Aya.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Aya.Button}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource PrimaryHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Aya.Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Aya.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Aya.Button.Destructive" TargetType="ButtonBase" BasedOn="{StaticResource Aya.Button}">
        <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource DestructiveHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DestructiveForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Aya.Button.Agent" TargetType="ButtonBase" BasedOn="{StaticResource Aya.Button}">
        <Setter Property="Background" Value="{DynamicResource AgentBrush}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource AgentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AgentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ui:Ui.Glow" Value="True" />
    </Style>

    <!-- Icon button: 32 px square, radius 8, bordered (card + border) or borderless; active = primary 12 % fill,
         primary icon. ui:Ui.ShowDot adds the 7 px red recording dot at the top right. -->
    <Style x:Key="Aya.IconButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="Glyph" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource Font.Icon}" FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource RecordingBrush}" Visibility="Collapsed"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="ui:Ui.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint12Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="ui:Ui.ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Aya.IconButton.Borderless" TargetType="ButtonBase" BasedOn="{StaticResource Aya.IconButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Window caption buttons (custom title bar of the main window) -->
    <Style x:Key="Aya.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Aya.CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource Aya.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chip: capsule, 13 pt, padding 12 x 6, card/hover fill, border outline; active = agent 14 % + agent 60 % outline -->
    <Style x:Key="Aya.Chip" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="ui:Ui.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AgentTint14Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AgentBorder60Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link-like text button (hyperlink style, no chrome) -->
    <Style x:Key="Aya.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Text input -->
    <!-- min height 32, padding 10 x 7, card fill, input outline, radius 8; optional ui:Ui.Icon (12 pt textSubtle)
         and ui:Ui.Placeholder. Focus: primary outline. -->
    <Style x:Key="Aya.TextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ui:Ui.CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding (ui:Ui.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"
                                       Text="{Binding (ui:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource TextSubtleBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Aya.TextBox}" />

    <!-- Search field: TextBox with the magnifier icon -->
    <Style x:Key="Aya.SearchBox" TargetType="TextBox" BasedOn="{StaticResource Aya.TextBox}">
        <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Search}" />
        <Setter Property="ui:Ui.Placeholder" Value="Search" />
    </Style>

    <!-- Read-only, selectable text (transcript lines, answers): a borderless TextBox -->
    <Style x:Key="Aya.SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ ComboBox (Aya select, spec 03 §10) -->
    <Style x:Key="Aya.ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="11,0,32,0" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Aya.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Margin="8,0,8,12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PopoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The Popup margin above leaves room for the drop shadow; PopupAnimation Fade. -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="Check" Grid.Column="1" Text="{StaticResource Icon.Check}" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="11" Margin="12,0,0,0" Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List row: radius 8, padding 10 x 8, hover fill, selected = primary 10 % -->
    <Style x:Key="Aya.ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Aya.ListItem}" />

    <!-- Segmented control (spec 03 §12): a ListBox with this style. Bordered group, 1 px dividers,
         selected segment primary 10 % fill with primary semibold text. Items: ui:Segment or any object
         (ToString). -->
    <Style x:Key="Aya.SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Aya.Segmented" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Aya.SegmentItem}" />
        <Setter Property="AlternationCount" Value="1000" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="11" Margin="0,1,5,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Grid>
                        <Border x:Name="Mask" Background="{DynamicResource CardBrush}" CornerRadius="8" />
                        <ItemsPresenter Margin="1">
                            <ItemsPresenter.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Mask}" />
                            </ItemsPresenter.OpacityMask>
                        </ItemsPresenter>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ CheckBox and switch -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBrush}" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="{StaticResource Icon.Check}" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBorder60Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch (ToggleButton or CheckBox): label (+ ui:Ui.Hint) on the left, 36 x 20 track on the right; on = primary -->
    <Style x:Key="Aya.Switch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Aya.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="Medium" />
                            <TextBlock x:Name="Hint" Text="{Binding (ui:Ui.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource InputBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Hint" Value="{x:Null}">
                            <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ ScrollBar (thin, rounded thumb, no arrows) -->
    <Style x:Key="Aya.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource TextSubtleBrush}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Aya.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Aya.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Aya.ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Aya.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Aya.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Aya.ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Aya.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="6,0,6,8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" MaxWidth="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.12" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Context menus (row menus and the tray menu) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8,4,8,12" Background="{DynamicResource PopoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" MinHeight="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="CheckMark" Text="{StaticResource Icon.Check}" FontFamily="{StaticResource Font.Icon}"
                                           FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock x:Name="Arrow" Grid.Column="3" Text="{StaticResource Icon.ChevronRight}" FontFamily="{StaticResource Font.Icon}"
                                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-9" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
                            <Border Margin="8,4,8,12" Background="{DynamicResource PopoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="180">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ ProgressBar: 4 px capsule, muted track, agent fill -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource AgentBrush}" />
        <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Settings tabs (icon over title, centred toolbar) -->
    <Style x:Key="Aya.SettingsTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,6" Margin="2,0" MinWidth="72">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding (ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="18" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,4,0,0"
                                              TextElement.FontSize="11" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryTint10Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Aya.SettingsTabs" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Aya.SettingsTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Aya building blocks -->
    <Style TargetType="ui:Card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Card">
                    <Grid>
                        <!-- Shadow and glow sit on separate borders so the text in the content stays crisp. -->
                        <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.05" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Glow" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect Color="#35D2C1" BlurRadius="28" ShadowDepth="0" Opacity="0.23" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasShadow" Value="False">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAgent" Value="True" />
                                <Condition Property="IsLit" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AgentBorder60Brush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:Eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Eyebrow">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Icon" Text="{TemplateBinding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                   Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                        <!-- WPF has no letter spacing; the Mac's 1.2 pt tracking is left out. -->
                        <TextBlock Text="{TemplateBinding Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:AyaTag">
        <Setter Property="Tint" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:AyaTag">
                    <Border CornerRadius="6" Padding="7,3"
                            Background="{Binding Tint, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BrushOpacity}, ConverterParameter=0.12}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                       Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{TemplateBinding Tint}" />
                            <TextBlock Text="{TemplateBinding Text}" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Tint}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:PanelBox">
        <Setter Property="HeaderBrush" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PanelBox">
                    <ui:Card Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Trailing}" VerticalAlignment="Center"
                                                  TextElement.FontSize="11" TextElement.FontWeight="Medium"
                                                  TextElement.Foreground="{DynamicResource TextMutedBrush}" />
                                <ui:Eyebrow Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Icon="{TemplateBinding Icon}"
                                            Foreground="{TemplateBinding HeaderBrush}" />
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </ui:Card>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:PageHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PageHeader">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Trailing}" VerticalAlignment="Bottom" />
                        <StackPanel>
                            <ui:Eyebrow Text="{Binding Eyebrow, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="{DynamicResource AgentTextMidBrush}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Aya.Text.Title}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Sub" Style="{StaticResource Aya.Text.Muted}" Text="{TemplateBinding Subtitle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:LogoTile">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:LogoTile">
                    <!-- radius = 0.28 x size; mark = 0.5 x size, nudged down 2 % -->
                    <Viewbox>
                        <Grid Width="100" Height="100">
                            <Border CornerRadius="28" Background="{DynamicResource BrandBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F7DFF" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.25" />
                                </Border.Effect>
                            </Border>
                            <Path Data="{StaticResource Geometry.AyaMark}" Fill="White" Stretch="Uniform" Width="50" Height="50"
                                  Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:Backdrop">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Backdrop">
                    <Grid>
                        <Rectangle Fill="{DynamicResource BackdropBlueBrush}" />
                        <Rectangle Fill="{DynamicResource BackdropTealBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:Spinner">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Spinner">
                    <Viewbox>
                        <Path Width="24" Height="24" Stroke="{TemplateBinding Foreground}" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M12,2 A10,10 0 1 1 2,12" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:StepLine">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:StepLine">
                    <StackPanel x:Name="Root" Orientation="Horizontal">
                        <ui:Spinner x:Name="Spin" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="Icon" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBox x:Name="Msg" Style="{StaticResource Aya.SelectableText}" Text="{TemplateBinding Message}" FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Idle">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Working">
                            <Setter TargetName="Spin" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Done">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Text" Value="{StaticResource Icon.CheckCircle}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Kind" Value="Done" />
                                <Condition Property="Message" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Kind" Value="Failed">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Text" Value="{StaticResource Icon.Warning}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:ScreenPlaceholder">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ScreenPlaceholder">
                    <Grid Margin="20">
                        <StackPanel VerticalAlignment="Top">
                            <ui:PageHeader Eyebrow="{TemplateBinding Eyebrow}" Title="{TemplateBinding Title}" Subtitle="{TemplateBinding Subtitle}" />
                            <Border Margin="0,20,0,0" CornerRadius="10" BorderThickness="1" Padding="16,14"
                                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource FieldBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Aya.Icon}" Text="{StaticResource Icon.Info}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Style="{StaticResource Aya.Text.Muted}" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="This screen is filled in by the next build phase." />
                                        <Run Text="{Binding Spec, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextSubtleBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
