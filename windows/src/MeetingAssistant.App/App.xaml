<Application x:Class="MeetingAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] colour tokens: swapped between Colors.Light.xaml and Colors.Dark.xaml by ThemeManager -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <!-- metrics, typography, icons and control styles -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <!-- navigation: view model → view -->
                <ResourceDictionary Source="Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
